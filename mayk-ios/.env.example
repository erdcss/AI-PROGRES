# M.A.Y.K uses the existing AI PROGRES website.
EXPO_PUBLIC_MAYK_WEB_URL=https://progres.turmarkt.com
# Linked Expo project: @erdcls/mayk-ios (the UUID is committed in app.config.js).
# MAYK_EAS_PROJECT_ID can override it for other environments but is not required.
# MAYK_EAS_PROJECT_ID=904c797e-7ddc-46a6-b5ed-e081f1c39bd3
# To enforce an admin-uploaded 1024×1024 logo in production builds:
MAYK_REQUIRE_REMOTE_ICON=0
