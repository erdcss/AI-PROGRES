# TELEGRAM_CHAT_ID=

# OpenAI
OPENAI_API_KEY=

# Scrape (production)
# BROWSER_WORKER_URL=
# BROWSER_WORKER_TOKEN=

# Opsiyonel residential HTTP proxy (Direct HTML + Puppeteer)
# TRENDYOL_HTTP_PROXY=http://user:pass@host:port
# INTERNAL_PROXY_URL=

