# Shopify (Postman ile aynı mantık)
SHOPIFY_SHOP_DOMAIN=magaza.myshopify.com
SHOPIFY_STORE_DOMAIN=ornek.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
